{
  "name": "mock-api",
  "version": "0.1.0",
  "description": "Fake-data APIs that follow OpenAPI 3.1, with views for front ends, AI-generated modules and a web panel.",
  "license": "Apache-2.0",
  "author": "Leandro Martins (https://github.com/leandro-jm)",
  "homepage": "https://github.com/leandro-jm/generative-mock-api#readme",
  "bugs": {
    "url": "https://github.com/leandro-jm/generative-mock-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandro-jm/generative-mock-api.git"
  },
  "keywords": [
    "mock",
    "mock-api",
    "fake-data",
    "openapi",
    "swagger",
    "rest",
    "prototyping",
    "ai",
    "generative"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @mock/web build",
    "start": "pnpm --filter @mock/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
