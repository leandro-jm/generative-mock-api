# Só o que precisa existir antes de o app subir. Todo o resto se configura na tela (Configurações)
# e qualquer chave da tela também pode vir daqui como valor inicial (ver README).

# Obrigatória em produção: assina sessões e JWT e cifra os segredos guardados no banco.
# Gere com: openssl rand -base64 48
APP_SECRET=

PORT=4310
DATA_DIR=./data
# Opcional: exige este token na tela de criação do primeiro admin.
SETUP_TOKEN=
# Quantos proxies confiar para ler o IP real (Traefik do Dokploy = 1; com Cloudflare na frente, 2).
TRUST_PROXY=1
LOG_LEVEL=info

# Exemplos de valores iniciais de configurações da tela:
# PUBLIC_URL=https://mock.exemplo.com
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
